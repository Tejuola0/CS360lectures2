name:          haskell-onboarding
version:       0.1
cabal-version: >= 1.10
build-type:    Simple

library
  exposed-modules: Studio
  hs-source-dirs:  .
  build-depends:   base >= 4 && < 5
  default-language: Haskell2010
  ghc-options: -Wall

test-suite checks
  type: exitcode-stdio-1.0
  main-is: Checks.hs
  hs-source-dirs: test
  build-depends:
      base >= 4 && < 5,
      haskell-onboarding
  default-language: Haskell2010
  ghc-options: -Wall
